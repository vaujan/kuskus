{
  "name": "kuskus",
  "version": "0.0.3",
  "license": "GPL-3.0-only",
  "description": "A private visual library for project references, stored on your computer",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.26.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:all": "pnpm audit",
    "clean": "node scripts/clean.cjs",
    "lint": "eslint --cache --max-warnings=0 .",
    "test": "node --test \"tests/*.test.cjs\"",
    "demo:seed": "node scripts/create-demo-library.cjs",
    "demo:reset": "node scripts/create-demo-library.cjs --reset",
    "perf:benchmark": "node scripts/benchmark-performance.cjs",
    "perf:budget": "node scripts/check-performance-budget.cjs",
    "perf:packaged": "pnpm build:unpack && node scripts/measure-packaged-performance.cjs",
    "dev:demo": "node scripts/run-demo.cjs",
    "dev:onboarding": "node scripts/run-onboarding.cjs",
    "onboarding:reset": "node scripts/run-onboarding.cjs --reset-only",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:landing": "pnpm --dir landing-page dev",
    "build": "pnpm build:icons && pnpm licenses:generate && pnpm typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:icons": "node scripts/generate-icons.cjs",
    "build:unpack": "pnpm build && electron-builder --dir --publish never",
    "build:win": "pnpm build && electron-builder --win --publish never",
    "build:mac": "pnpm exec install-electron && pnpm build && electron-builder --mac --publish never",
    "build:linux": "pnpm build && electron-builder --linux --publish never",
    "release": "node scripts/release.cjs",
    "release:prepare": "node scripts/versioning.cjs prepare",
    "release:verify": "node scripts/versioning.cjs verify",
    "changelog:generate": "node scripts/versioning.cjs generate",
    "version:check": "node scripts/versioning.cjs check",
    "check": "pnpm version:check && pnpm format:check && pnpm test && pnpm lint && pnpm build && pnpm perf:budget && pnpm --dir landing-page typecheck && pnpm --dir landing-page build",
    "check:release": "pnpm check && pnpm audit && pnpm build:storybook && pnpm exec electron-builder --dir --publish never && pnpm package:verify",
    "licenses:generate": "node scripts/generate-third-party-notices.cjs",
    "package:verify": "node scripts/verify-package.cjs"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@replit/codemirror-vim": "6.4.0",
    "@tabler/icons-react": "^3.49.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "katex": "0.18.10",
    "mermaid": "^11.17.2",
    "node-diff3": "^3.2.1",
    "pdfjs-dist": "^6.4.299",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.30.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "^3.4.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-grab": "^0.2.0",
    "react-scan": "^0.5.7",
    "semver": "^7.8.5",
    "storybook": "10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "author": "Kuskus contributors",
  "homepage": "https://github.com/vaujan/kuskus",
  "repository": {
    "type": "git",
    "url": "https://github.com/vaujan/kuskus.git"
  },
  "bugs": {
    "url": "https://github.com/vaujan/kuskus/issues"
  }
}
